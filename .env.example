# FERKO production environment — copy to .env and fill in. Do NOT commit the real .env.
#   docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# --- Database (required) ---
FERKO_DB_NAME=ferko
FERKO_DB_USERNAME=ferko
FERKO_DB_PASSWORD=change-me-strong-password

# --- HTTP / image ---
FERKO_HTTP_PORT=8080
FERKO_IMAGE=ferko-web-api:prod
FERKO_JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseStringDeduplication

# --- Authentication ---
# Preferred: OIDC (e.g. AAI@EduHr). Set the issuer (and optionally jwk-set) and leave HMAC off.
FERKO_OIDC_ISSUER_URI=
FERKO_OIDC_JWK_SET_URI=
# Self-hosting without an IdP: enable the HMAC decoder and set a strong (>= 32 char) secret.
FERKO_JWT_ALLOW_HMAC_DECODER=false
FERKO_JWT_HMAC_SECRET=

# --- Hardening ---
FERKO_LOGIN_RATE_LIMIT_ENABLED=true

# --- E-mail (optional) ---
# Leave disabled to use the logging sender. To send real mail, enable and set the SMTP host.
FERKO_MAIL_ENABLED=false
FERKO_MAIL_HOST=
FERKO_MAIL_PORT=587
FERKO_MAIL_USERNAME=
FERKO_MAIL_PASSWORD=
FERKO_MAIL_FROM=ferko@fer.hr

# --- Default grade thresholds (a course may override its own; 50 is always the passing minimum) ---
FERKO_GRADING_EXCELLENT=88
FERKO_GRADING_VERY_GOOD=75
FERKO_GRADING_GOOD=62
FERKO_GRADING_SUFFICIENT=50

# --- Scheduling engine defaults ---
FERKO_SCHEDULER_POPULATION=60
FERKO_SCHEDULER_ITERATIONS=5000
FERKO_SCHEDULER_SEED=42
